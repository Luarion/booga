{
	"name": "@booga/db",
	"module": "./src/index.ts",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./schema": {
			"types": "./src/schema.ts",
			"default": "./src/schema.ts"
		}
	},
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:erd": "drizzle-erd --in src/db/schema/index.ts --out erd.svg",
		"db:generate": "drizzle-kit generate",
		"db:export": "drizzle-kit export",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:seed": "bun scripts/seed.ts",
		"db:reset": "bun scripts/reset.ts",
		"db:docs": "mkdir docs -p; drizzle-mermaid-generator --schema src/schema.ts --dialect pg -o docs/schema.mmd && drizzle-docs generate src/schema.ts -d postgresql -f dbml -o docs/schema.dbml --force && drizzle-docs generate src/schema.ts -d postgresql -f markdown -o docs/README.md --single-file --no-er-diagram --force"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.48",
		"drizzle-orm": "^0.45.1",
		"drizzle-typebox": "^0.3.3",
		"postgres": "^3.4.8"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@repo/biomejs": "workspace:*",
		"drizzle-docs-generator": "^0.7.1",
		"drizzle-erd": "^0.0.1-alpha.11",
		"drizzle-kit": "^0.31.10",
		"drizzle-mermaid-generator": "^0.0.5",
		"drizzle-seed": "^0.3.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
