{
  "name": "@booga/api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun run build.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:erd": "drizzle-erd --in src/db/schema/index.ts --out erd.svg",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun ./scripts/db/seed.ts",
    "db:reset": "bun ./scripts/db/reset.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/swagger": "^1.3.1",
    "bonjour-service": "^1.3.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.25",
    "mime": "^4.1.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "drizzle-erd": "^0.0.1-alpha.11",
    "drizzle-kit": "^0.31.8",
    "drizzle-seed": "^0.3.1"
  }
}